# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and should never be committed.

# PostgreSQL connection string
DATABASE_URL=postgres://servicepulse:secret@localhost:5432/servicepulse?sslmode=disable

# Port the API server listens on
SERVER_PORT=8080

# Application environment (development | production)
APP_ENV=development

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=servicepulse
POSTGRES_PASSWORD=secret
POSTGRES_DB=servicepulse
